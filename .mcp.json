{
  "mcpServers": {
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "--yes",
        "@playwright/mcp@0.0.83",
        "--headless",
        "--isolated",
        "--allowed-hosts",
        "localhost,*.supabase.co",
        "--allowed-origins",
        "http://localhost:*;https://*.supabase.co",
        "--block-service-workers"
      ],
      "env": {}
    },
    "graphify": {
      "type": "stdio",
      "command": "python",
      "args": [
        "-m",
        "graphify.serve",
        "graphify-out/graph.json"
      ],
      "env": {}
    }
  }
}